    "storybook:android": "cross-env STORYBOOK_ENABLED='true' expo start --android",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "format": "prettier --write \"**/*.{tsx,ts,jsx,js,json,md}\"",
