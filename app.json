{
  "expo": {
    "name": "lampstand Mobile",
    "slug": "lampstand-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splashscreen.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ea4335"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.greatertomi.lampstandmobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lampstand access your photos",
          "cameraPermission": "Allow Lampstand to access your camera."
        }
      ],
      [
        "expo-notifications",
        {
          "useNextNotificationsApi": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "afa06c24-b999-4e99-a9ac-c1c1b61d76e4"
      }
    }
  }
}
